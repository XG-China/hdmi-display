[
  {
    "stepTitle": "HDMI Display 设置",
    "items": [
      {
        "type": "text",
        "field": "wizard_port",
        "label": "网页管理面板端口",
        "initValue": "8080",
        "rules": [
          {
            "required": true,
            "message": "请输入端口号"
          },
          {
            "pattern": "^[0-9]+$",
            "message": "端口只能包含数字"
          }
        ]
      },
      {
        "type": "radio",
        "field": "wizard_stop_compositor",
        "label": "appliance-compositor（电视合成器）",
        "initValue": "keep",
        "options": [
          {
            "label": "保持当前设置（修改配置或升级时不改变）",
            "value": "keep"
          },
          {
            "label": "保持运行（HDMI Display 可能无法取得 DRM 主控权）",
            "value": "false"
          },
          {
            "label": "HDMI Display 运行时停止它，停止应用时自动恢复",
            "value": "true"
          }
        ]
      },
      {
        "type": "radio",
        "field": "wizard_web_deps",
        "label": "网页源依赖（xvfb + chromium）",
        "initValue": "keep",
        "options": [
          {
            "label": "保持现状（不安装；需要时再手动执行 apt install xvfb chromium）",
            "value": "keep"
          },
          {
            "label": "通过 apt 安装 xvfb + chromium（约 300 MB，需要联网）",
            "value": "install"
          }
        ]
      },
      {
        "type": "tips",
        "helpText": "修改端口后会自动重建服务并恢复原来的运行状态。网页源依赖只在需要时安装；视频、图片、VNC、RDP 和画中画不需要额外软件。"
      }
    ]
  }
]
